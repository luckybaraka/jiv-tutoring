# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/jiv_tutoring

# Email - Primary: Resend (HTTPS API; works from cloud hosts like Render)
# RESEND_FROM must be on a domain verified in Resend
RESEND_API_KEY=
RESEND_FROM=info@jivtutoring.com

# Email - Fallback: SMTP (used only when RESEND_API_KEY is empty; mostly for local dev)
# cPanel: host = mail.yourdomain.com (or server hostname), port 465 (SSL) / 587 (STARTTLS)
# Gmail/Workspace: host = smtp.gmail.com, port 587, EMAIL_PASS = 16-char App Password
EMAIL_HOST=mail.jivtutoring.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@jivtutoring.com
EMAIL_PASS=your_mailbox_password_here
ADMIN_EMAIL=info@jivtutoring.com
EMAIL_FROM_NAME=JIV Tutoring Services

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin Default
ADMIN_DEFAULT_EMAIL=info@jivtutoring.com
ADMIN_DEFAULT_PASSWORD=ChangeThisInProduction!2026

# News API (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here
NEWS_API_URL=https://newsapi.org/v2/everything
