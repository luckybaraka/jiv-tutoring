# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/jiv_tutoring

# Email (Nodemailer SMTP)
# For cPanel hosted mail: host = mail.yourdomain.com, port 465 (SSL) or 587 (STARTTLS)
# For Gmail/Workspace: host = smtp.gmail.com, port 587, EMAIL_PASS must be a 16-char App Password
# EMAIL_SECURE: leave blank to auto-derive from port (true for 465, false otherwise), or force "true"/"false"
EMAIL_HOST=mail.jivtutoring.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@jivtutoring.com
EMAIL_PASS=your_mailbox_password_here
ADMIN_EMAIL=info@jivtutoring.com
EMAIL_FROM_NAME=JIV Tutoring Services

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin Default
ADMIN_DEFAULT_EMAIL=info@jivtutoring.com
ADMIN_DEFAULT_PASSWORD=ChangeThisInProduction!2026

# News API (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here
NEWS_API_URL=https://newsapi.org/v2/everything
